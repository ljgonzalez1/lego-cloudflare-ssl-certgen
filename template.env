# Configuration template for lego-cloudflare-certgen 3.4.0.
# Copy to .env and fill in the token, email and ACME terms setting.

# Timezone (IANA format).  Default: Etc/UTC
# Examples: America/Santiago  Europe/London  Asia/Tokyo
TZ=

# Contact e-mail for the Let's Encrypt account. Required for issuance.
EMAIL=

# Issue real certificates.  Default: false (staging)
# Production issuance is subject to Let's Encrypt rate limits.
PRODUCTION=

# Domains are read from the YAML file mounted at /app/domains.yaml.
# See domains.yaml and template.domains.yaml for the group format.

# Cloudflare DNS API token with DNS edit and zone read permissions.
CLOUDFLARE_API_TOKEN=

# Maximum wait for DNS TXT propagation per challenge in seconds. Default: 360
PROPAGATION_SECONDS=

# DNS resolvers for propagation verification (host:port, comma-separated).
# Default: 1.1.1.1:53,8.8.8.8:53,1.0.0.1:53
DNS_RESOLVERS=

# Accept Let's Encrypt Terms of Service.  Must be 'true'.  Required.
# See: https://letsencrypt.org/repository/
ACCEPT_LEGO_TOS=

# Certificate file ownership (UID/GID).  Default: 1000
# Must be non-zero. Set to match the user that reads the certs on the host.
UID=
GID=
