# Sample local settings for lego-cloudflare-certgen 5.1.1.
# See README.md for docker run and Docker Compose.

# Timezone for log timestamps and output directory names.
# Must be a valid IANA timezone name.
# Examples: Etc/UTC  America/Santiago  Europe/London  Asia/Tokyo
# Default: Etc/UTC
TZ=America/Santiago

# Contact e-mail registered with Let's Encrypt.
# Used for account creation and recovery contact.
# Required.
EMAIL=user@example.com

# Choose Staging or Production in the issuance menu.

# Domains are read from the YAML file mounted at /app/domains.yaml.
# Copy template.domains.yaml to domains.yaml and edit the groups.

# Cloudflare DNS API token with Zone > DNS > Edit and Zone > Zone > Read.
# Compose passes it to the container as a secret file.
# Required.
CLOUDFLARE_API_TOKEN=

# Maximum wait for DNS TXT record propagation per challenge before notifying
# Let's Encrypt to validate.  Increase if validation fails with timeout errors.
# The time limit of each certificate is computed from this value:
# (120 + names x (PROPAGATION_SECONDS + 60)) x 1.5 seconds, at most 2 hours.
# Default: 360
PROPAGATION_SECONDS=360

# How lego's progress is shown:
# auto   -- live view with a marker per name in a terminal, lego's own log otherwise
# pretty -- always the live view
# raw    -- always lego's own log
# lego's full output is always saved as lego.log next to the certificates.
# Default: auto
LEGO_OUTPUT=auto

# DNS resolvers used by lego to verify that the TXT record is publicly visible.
# Comma-separated list of host:port pairs.
# Default: 1.1.1.1:53,8.8.8.8:53,1.0.0.1:53  (Cloudflare primary/secondary + Google)
DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53,1.0.0.1:53

# Accept the Let's Encrypt Terms of Service.
# Must be explicitly set to 'true'. Certificate generation will fail otherwise.
# Review the TOS at: https://letsencrypt.org/repository/
# Default: false
ACCEPT_LEGO_TOS=false

# UID and GID for certificate file ownership on the host volume.
# Set these to match the user that will read the certificates on the host.
# Must be non-zero. Default: 1000
UID=1000
GID=1000
